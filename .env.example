# Configuración de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Configuración de la Aplicación
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Integración con WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-system-user-access-token
WHATSAPP_VERIFY_TOKEN=your-custom-webhook-verify-token
# Secreto de la app de Meta: valida la firma HMAC del webhook entrante (obligatorio)
WHATSAPP_APP_SECRET=your-meta-app-secret

# API de Inteligencia Artificial (Gemini)
GEMINI_API_KEY=your-google-gemini-api-key

# Correo transaccional (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=no-reply@tudominio.com

# Secreto del cron de recordatorios (Vercel Cron envía Authorization: Bearer ${CRON_SECRET})
CRON_SECRET=your-long-random-cron-secret
